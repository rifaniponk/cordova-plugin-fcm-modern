<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-fcm-modern" version="8.0.0">
	<name>FCM Modern</name>
	<description>Firebase Cloud Messaging for Cordova and Capacitor (Android + iOS), event-only foreground delivery, no install-time hooks.</description>
	<license>MIT</license>
	<keywords>ecosystem:cordova, notifications, push, firebase, fcm, ios, android, cordova, capacitor</keywords>
	<repo>https://github.com/rifaniponk/cordova-plugin-fcm-modern.git</repo>

	<!-- The Cordova module loader cannot resolve arbitrary npm-relative files,
	     so the js-module is the committed single-file CommonJS bundle. -->
	<js-module src="dist/cordova/fcm-cordova.bundle.cjs" name="FCMPlugin">
		<clobbers target="FCM" />
	</js-module>

	<engines>
		<engine name="cordova" version=">=11.0.0" />
		<engine name="cordova-android" version=">=13.0.0" />
		<engine name="cordova-ios" version=">=7.0.0" />
	</engines>

	<!-- ANDROID CONFIGURATION -->
	<platform name="android">
		<preference name="ANDROID_DEFAULT_NOTIFICATION_ICON" default="@mipmap/ic_launcher" />
		<preference name="ANDROID_FIREBASE_BOM_VERSION" default="35.1.0" />
		<preference name="ANDROID_GOOGLE_SERVICES_VERSION" default="4.5.0" />
		<preference name="ANDROID_GRADLE_TOOLS_VERSION" default="8.1.0" />

		<!-- The tap activity is internal: no intent-filter and exported=false
		     mean third-party apps cannot forge tap events via an exported
		     activity. The service is the only exported-by-Firebase component. -->
		<config-file target="AndroidManifest.xml" parent="/manifest/application">
			<activity android:name="dev.rifan.fcmmodern.service.FCMModernTapActivity" android:exported="false" android:launchMode="singleTop" />
			<service
				android:name="dev.rifan.fcmmodern.service.FCMModernMessagingService"
				android:exported="false"
				android:stopWithTask="false">
				<intent-filter>
					<action android:name="com.google.firebase.MESSAGING_EVENT"/>
				</intent-filter>
			</service>
			<meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="$ANDROID_DEFAULT_NOTIFICATION_ICON" />
		</config-file>
		<config-file target="res/xml/config.xml" parent="/*">
			<feature name="FCMPlugin">
				<param name="android-package" value="dev.rifan.fcmmodern.cordova.FCMModernCordovaPlugin"/>
				<param name="onload" value="true" />
			</feature>
		</config-file>
		<config-file target="config.xml" parent="/*">
			<platform name="android">
				<preference name="AndroidXEnabled" value="true" />
			</platform>
		</config-file>
		<framework src="src/android/FCMPlugin.gradle" custom="true" type="gradleReference"/>

		<!-- Shared core + service (Cordova route excludes the Capacitor adapter;
		     Capacitor consumers apply fcm-modern-capacitor.gradle instead). -->
		<source-file src="src/android/dev/rifan/fcmmodern/core/FcmEventBus.java" target-dir="src/dev/rifan/fcmmodern/core" />
		<source-file src="src/android/dev/rifan/fcmmodern/core/FCMPayload.java" target-dir="src/dev/rifan/fcmmodern/core" />
		<source-file src="src/android/dev/rifan/fcmmodern/core/FCMModernCore.java" target-dir="src/dev/rifan/fcmmodern/core" />
		<source-file src="src/android/dev/rifan/fcmmodern/android/AndroidFirebaseGateway.java" target-dir="src/dev/rifan/fcmmodern/android" />
		<source-file src="src/android/dev/rifan/fcmmodern/service/FCMModernHolder.java" target-dir="src/dev/rifan/fcmmodern/service" />
		<source-file src="src/android/dev/rifan/fcmmodern/service/FCMModernMessagingService.java" target-dir="src/dev/rifan/fcmmodern/service" />
		<source-file src="src/android/dev/rifan/fcmmodern/service/FCMModernTapActivity.java" target-dir="src/dev/rifan/fcmmodern/service" />
		<source-file src="src/android/dev/rifan/fcmmodern/cordova/FCMModernCordovaPlugin.java" target-dir="src/dev/rifan/fcmmodern/cordova" />
	</platform>

	<!-- IOS CONFIGURATION -->
	<platform name="ios">
		<preference name="IOS_FIREBASE_MESSAGING_VERSION" default="~> 13.1.1" />
		<config-file target="config.xml" parent="/*">
			<feature name="FCMPlugin">
				<param name="ios-package" value="FCMPlugin"/>
			</feature>
		</config-file>

		<!-- ENABLE PUSH CAPABILITY -->
		<config-file parent="aps-environment" target="*/Entitlements-Debug.plist">
			<string>development</string>
		</config-file>
		<config-file parent="aps-environment" target="*/Entitlements-Release.plist">
			<string>production</string>
		</config-file>
		<config-file target="*-Info.plist" parent="UIBackgroundModes">
			<array>
				<string>remote-notification</string>
			</array>
		</config-file>
		<config-file target="*-Info.plist" parent="FirebaseAppDelegateProxyEnabled">
			<false/>
		</config-file>

		<!-- Shared native core (also shipped via fcm-modern.podspec) plus the
		     Cordova CDVPlugin adapter. The Capacitor Swift adapter ships via
		     Package.swift and is deliberately not compiled for Cordova. -->
		<header-file src="src/ios/core/FCMModernCore.h" />
		<source-file src="src/ios/core/FCMModernCore.m" />
		<header-file src="src/ios/core/FCMEventBus.h" />
		<source-file src="src/ios/core/FCMEventBus.m" />
		<header-file src="src/ios/core/FCMPayload.h" />
		<source-file src="src/ios/core/FCMPayload.m" />
		<header-file src="src/ios/core/FCMNotificationDelegate.h" />
		<source-file src="src/ios/core/FCMNotificationDelegate.m" />

		<header-file src="src/ios/cordova/FCMPlugin.h" />
		<source-file src="src/ios/cordova/FCMPlugin.m" />

		<!-- FIREBASE COCOAPODS-->
		<podspec>
			<config>
				<source url="https://github.com/CocoaPods/Specs.git"/>
			</config>
			<pods>
				<pod name="Firebase/Messaging" spec="$IOS_FIREBASE_MESSAGING_VERSION"/>
			</pods>
		</podspec>
	</platform>
</plugin>
