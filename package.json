{
    "name": "cordova-plugin-fcm-modern",
    "version": "8.0.0",
    "description": "Firebase Cloud Messaging push notifications for Cordova and Capacitor (Android + iOS), with optional Ionic/Angular wrappers",
    "license": "MIT",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./cordova": {
            "types": "./dist/types/cordova/index.d.ts",
            "import": "./dist/esm/cordova/index.js",
            "require": "./dist/cjs/cordova/index.js"
        },
        "./core": {
            "types": "./dist/types/core/index.d.ts",
            "import": "./dist/esm/core/index.js",
            "require": "./dist/cjs/core/index.js"
        },
        "./capacitor": {
            "types": "./dist/types/capacitor/index.d.ts",
            "import": "./dist/esm/capacitor/index.js",
            "require": "./dist/cjs/capacitor/index.js"
        },
        "./ionic": {
            "types": "./dist/types/ionic/index.d.ts",
            "import": "./dist/esm/ionic/index.js",
            "require": "./dist/cjs/ionic/index.js"
        },
        "./ionic/ngx": {
            "types": "./dist/types/ionic/ngx/index.d.ts",
            "import": "./dist/esm/ionic/ngx/index.js",
            "require": "./dist/cjs/ionic/ngx/index.js"
        },
        "./ionic/v4": {
            "types": "./dist/types/ionic/v4/index.d.ts",
            "import": "./dist/esm/ionic/v4/index.js",
            "require": "./dist/cjs/ionic/v4/index.js"
        },
        "./package.json": "./package.json"
    },
    "cordova": {
        "id": "cordova-plugin-fcm-modern",
        "platforms": [
            "android",
            "ios"
        ]
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "node scripts/typecheck.mjs",
        "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
        "test": "node scripts/test.mjs",
        "test:unit": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-js-hook.mjs --test tests/*.test.ts",
        "test:aot": "node scripts/ngc-fixture.mjs",
        "audit": "npm audit --audit-level=low",
        "verify": "npm run format:check && npm run typecheck && npm run build && npm run test && npm run test:aot && npm run audit"
    },
    "files": [
        "dist",
        "plugin.xml",
        "fcm-modern.podspec",
        "Package.swift",
        "src/android",
        "src/ios",
        "android",
        "ios",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rifaniponk/cordova-plugin-fcm-modern.git"
    },
    "issues": {
        "url": "https://github.com/rifaniponk/cordova-plugin-fcm-modern/issues"
    },
    "keywords": [
        "ecosystem:cordova",
        "cordova-android",
        "cordova-ios",
        "capacitor",
        "capacitor-plugin",
        "notifications",
        "push",
        "firebase",
        "fcm",
        "android",
        "ios"
    ],
    "peerDependencies": {
        "@angular/core": "^22.0.0",
        "@capacitor/core": "^8.5.3",
        "rxjs": "^7.8.2"
    },
    "peerDependenciesMeta": {
        "@angular/core": {
            "optional": true
        },
        "@capacitor/core": {
            "optional": true
        },
        "rxjs": {
            "optional": true
        }
    },
    "devDependencies": {
        "@angular/compiler": "22.2.3",
        "@angular/compiler-cli": "22.2.3",
        "@angular/core": "22.2.3",
        "@capacitor/core": "8.5.3",
        "@types/node": "26.6.5",
        "esbuild": "0.28.2",
        "prettier": "3.9.10",
        "rxjs": "7.8.2",
        "typescript": "6.0.3",
        "zone.js": "0.16.3"
    }
}
