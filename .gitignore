# Dependencies
node_modules/

# Build output is committed on purpose: Cordova/Capacitor installs straight from a
# git tag must work without a build step (see docs/ARCHITECTURE.md §8). Ignore only
# the leftovers that must not ship:
dist/**/*.map
dist/.tsbuildinfo

# Fixture / verification scratch (never part of the published package)
fixtures/**/node_modules/
fixtures/**/www/
fixtures/**/capacitor.config.json
fixtures/**/.gradle/
fixtures/**/build/
fixtures/**/*.apk
.tmp/

# Local toolchain + CI scratch
.gradle/
*.log
.qwen/

